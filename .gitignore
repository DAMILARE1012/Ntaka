!.yarn/plugins
!.yarn/sdks
!.yarn/versions
jspm_packages/

# --------------------------------------------------------------- build output
dist/
dist-ssr/
build/
out/
*.local

# Intermediate output from `npm run build:static` and the smoke scripts.
.prerender/
.smoke/

# ------------------------------------------------------- secrets & env config
# Never commit these. If a key ever does get pushed, rotate it - deleting the commit
# is not enough, GitHub and its forks keep the blob.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
.npmrc
.netrc
secrets.json
credentials.json
service-account*.json
*.keystore
*.jks

# ------------------------------------------------------------- AI / agent tools
# Local assistant state, transcripts and settings - machine-specific, and can quote
# file contents. `.claude/settings.json` is sometimes shared deliberately; if you ever
# want that, un-ignore just that one file.
.claude/
CLAUDE.local.md
.cursor/
.cursorignore
.aider*
.continue/
.windsurf/
.github-copilot/

