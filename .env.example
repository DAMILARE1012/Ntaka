# Copy to .env (which is gitignored) and fill in.
# Only VITE_* names are exposed to the client bundle - never put a secret in one.

# Canonical host. Every canonical link, og:url and sitemap entry is built from this.
# Getting it wrong tells Google your pages duplicate a site you do not own.
VITE_SITE_URL=https://ntaka.com

# Emit aggregateRating in the schema.org markup. Leave unset until the ratings are
# real reviews - rating markup over generated data is a manual-action risk.
# VITE_REVIEWS_ARE_REAL=true

# When a real backend replaces the in-memory catalogue in src/services/mock/.
# VITE_API_URL=https://api.ntaka.com
