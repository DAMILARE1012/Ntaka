# Copy to .env (which is gitignored) and fill in.
# Only VITE_* names are exposed to the client bundle - never put a secret in one.

# Canonical host. Every canonical link, og:url and sitemap entry is built from this.
# Getting it wrong tells Google your pages duplicate a site you do not own.
VITE_SITE_URL=https://ntaka.com

# Emit aggregateRating in the schema.org markup. Leave unset until the ratings are
# real reviews - rating markup over generated data is a manual-action risk.
# VITE_REVIEWS_ARE_REAL=true

# When a real backend replaces the in-memory catalogue in src/services/mock/.
# VITE_API_URL=https://api.ntaka.com

# ---------------------------------------------------------------- video calls
# Your Daily subdomain. Public - it appears in every room URL - so VITE_ is fine.
# VITE_DAILY_DOMAIN=ntaka.daily.co

# ---------------------------------------------------------------------------
# DAILY_API_KEY DOES NOT BELONG IN THIS FILE, OR IN ANY VITE_ VARIABLE.
#
# Vite inlines every VITE_-prefixed value into the public JavaScript bundle.
# Naming it VITE_DAILY_API_KEY would publish an account-level credential to
# every visitor: they could create and delete rooms, read recordings and run up
# your bill.
#
# It belongs in the SERVER environment only, read by server/join-lesson.js:
#     supabase secrets set DAILY_API_KEY=...        (Supabase Edge Functions)
#     vercel env add DAILY_API_KEY production       (Vercel)
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ assessment
# Groq, for placement writing assessment and (where supported) transcription.
# Free tier: ~30 req/min, 6,000 tokens/min, 1,000 req/day, ~2,000 transcriptions/day.
#
# Same rule as DAILY_API_KEY: SERVER ENVIRONMENT ONLY, never VITE_.
#     supabase secrets set GROQ_API_KEY=...
#
# Models are pinned in src/lib/groqAssessment.js:
#     chat        openai/gpt-oss-20b     (not 120B - 6x cheaper on the TPM limit)
#     transcribe  whisper-large-v3       (not turbo - accuracy over speed)
#
# Whisper covers 8 of the 25 languages. IGBO IS NOT ONE OF THEM, so Igbo speaking is
# never sent for transcription - it goes to a teacher instead. See server/assess-placement.js.

# -------------------------------------------------------------------- payments
# Paystack. Chosen over Stripe because Stripe does not properly support Nigerian
# businesses, and Paystack settles NGN with the local methods learners actually use:
# card, bank transfer, USSD and mobile money.
#
# The PUBLIC key is safe here - it is designed to be in the browser.
#     pk_test_...   test mode, no real money
#     pk_live_...   real cards, real money
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
#
# Test mode is inferred from the key prefix, never configured separately. A separate
# flag would eventually disagree with the key in use, and the failure mode is the worst
# one available: a live key behind a banner that says no money moves.
#
# ---------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY DOES NOT BELONG IN A VITE_ VARIABLE.
#
# It can refund, transfer funds out and read every customer record. Vite inlines every
# VITE_-prefixed value into public JavaScript, so VITE_PAYSTACK_SECRET_KEY would hand
# that to every visitor.
#
# Server environment only, read by server/paystack.js:
#     supabase secrets set PAYSTACK_SECRET_KEY=sk_test_...
#     vercel env add PAYSTACK_SECRET_KEY production
# ---------------------------------------------------------------------------
#
# Webhooks need a public URL. In development:
#     npx localtunnel --port 5173
# then set that URL in Paystack: Settings -> API Keys & Webhooks -> Webhook URL.
# The webhook is the reliable path to granting access - a learner who closes the tab
# after paying still gets what they paid for.

# Prices are set in USD and charged in NGN. This is a deliberate peg, not a live rate:
# a live rate would change the amount between the course page and the payment sheet.
# Review it alongside the customer-facing prices when you change it.
# VITE_USD_TO_NGN=1600
