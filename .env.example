# Copy to .env (which is gitignored) and fill in.
# Only VITE_* names are exposed to the client bundle - never put a secret in one.

# Canonical host. Every canonical link, og:url and sitemap entry is built from this.
# Getting it wrong tells Google your pages duplicate a site you do not own.
VITE_SITE_URL=https://ntaka.com

# Emit aggregateRating in the schema.org markup. Leave unset until the ratings are
# real reviews - rating markup over generated data is a manual-action risk.
# VITE_REVIEWS_ARE_REAL=true

# When a real backend replaces the in-memory catalogue in src/services/mock/.
# VITE_API_URL=https://api.ntaka.com

# ---------------------------------------------------------------- video calls
# Your Daily subdomain. Public - it appears in every room URL - so VITE_ is fine.
# VITE_DAILY_DOMAIN=ntaka.daily.co

# ---------------------------------------------------------------------------
# DAILY_API_KEY DOES NOT BELONG IN THIS FILE, OR IN ANY VITE_ VARIABLE.
#
# Vite inlines every VITE_-prefixed value into the public JavaScript bundle.
# Naming it VITE_DAILY_API_KEY would publish an account-level credential to
# every visitor: they could create and delete rooms, read recordings and run up
# your bill.
#
# It belongs in the SERVER environment only, read by server/join-lesson.js:
#     supabase secrets set DAILY_API_KEY=...        (Supabase Edge Functions)
#     vercel env add DAILY_API_KEY production       (Vercel)
# ---------------------------------------------------------------------------
